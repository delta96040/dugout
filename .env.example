# Copy to .env and fill in. Never commit .env.
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
GUARDIAN_API_KEY=
# Optional
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
# LLM (open-weight models only): <provider>:<model> entries tried in order (groq, openrouter, local = Ollama).
# Entries whose key is missing are skipped. Chosen on docs/backtests/writer_llm.md; local:dugout-writer-1.5b is the
# fine-tuned writer (docs/backtests/writer_finetune.md, install: tools/finetune/ollama_create.py).
LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,openrouter:poolside/laguna-s-2.1:free,local:dugout-writer-1.5b,local:qwen2.5:3b
# Ollama somewhere other than http://localhost:11434/v1
LLM_LOCAL_BASE_URL=
# Optional self-hosted SearXNG for news search
SEARXNG_URL=
# Optional local path to the PFF FC World Cup 2022 download (free sign-up, not redistributable)
PFF_DATA_DIR=
